rules_version = '2';

// Only the two household members may read or write the shopping lists.
// Replace both addresses with your own before publishing these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function member() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'erste.person@example.com',
          'zweite.person@example.com'
        ];
    }

    match /households/main/{document=**} {
      allow read, write: if member();
    }

    // Personal settings (light/dark), private to each account.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
